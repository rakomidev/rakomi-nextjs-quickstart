# Copy to .env.local and fill in your own tenant's values (never commit .env.local).
#
# Client-safe — Next.js inlines these into the browser bundle at build time. Get the client_id
# from your Rakomi dashboard: Integration -> Applications -> Create OAuth Application.
NEXT_PUBLIC_RAKOMI_CLIENT_ID=
# Only set this to point at a non-production Rakomi deployment (local dev / staging). Omit
# it to use the production default (https://api.rakomi.com).
NEXT_PUBLIC_RAKOMI_BASE_URL=

# Server-only — never prefixed with NEXT_PUBLIC_, never sent to the browser. RAKOMI_TENANT_ID
# pins server-side token verification (verifyRakomiToken) to YOUR tenant, so a token issued to
# a different tenant is rejected even if it is otherwise well-formed and correctly signed.
RAKOMI_TENANT_ID=

# Server-only. RAKOMI_ISSUER is the issuer of the Rakomi environment whose tokens this app accepts —
# the exact `iss` they carry. Every environment is its own issuer with its own signing keys:
#   default (Live) environment:  https://api.rakomi.com/t/<tenant public id>
#   any other environment:       https://api.rakomi.com/t/<tenant public id>/<environment slug>
# verifyRakomiToken reads the signing keys from the jwks_uri in this issuer's discovery document,
# so a token from another environment or tenant is rejected. Required.
RAKOMI_ISSUER=https://api.rakomi.com/t/tn_0123456789abcdef0123456789abcdef/test
# Optional: fetch the key set from somewhere other than the issuer's jwks_uri (e.g. a JWKS
# reverse proxy). Leave unset.
RAKOMI_JWKS_URL=

# RAKOMI_REGION documents this deployment's EU-residency pin; it is read here but not
# currently branched on. Rakomi is EU-native by construction.
RAKOMI_REGION=eu-central-1
